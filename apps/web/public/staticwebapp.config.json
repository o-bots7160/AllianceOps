{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/_next/*", "*.ico", "*.png", "*.jpg", "*.svg"]
  },
  "routes": [
    {
      "route": "/_next/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/images/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "*.ico",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "*.png",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "*.jpg",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "*.svg",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/privacy/",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],

  "responseOverrides": {
    "401": {
      "redirect": "/",
      "statusCode": 302
    }
  }
}
